<Window x:Class="BvhViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BVH Animation Viewer" Width="1100" Height="760"
        Background="#202124" Foreground="#E8EAED">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_檔案">
        <MenuItem Header="開啟 BVH..." Click="OpenClick"/>
        <Separator/>
        <MenuItem Header="結束" Click="ExitClick"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Padding="10" Background="#292A2D">
      <StackPanel>
        <Slider x:Name="Timeline" Minimum="0" ValueChanged="TimelineChanged"/>
        <DockPanel Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="PlayButton" Content="播放" Click="PlayClick"/>
            <Button Content="重設" Click="ResetClick"/>
            <TextBlock x:Name="FrameLabel" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SpeedBox" Width="80" SelectedIndex="2" SelectionChanged="SpeedChanged">
              <ComboBoxItem Content="0.25x"/><ComboBoxItem Content="0.5x"/>
              <ComboBoxItem Content="1x"/><ComboBoxItem Content="2x"/>
            </ComboBox>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <Grid>
      <Canvas x:Name="Viewport" Background="#111214" SizeChanged="ViewportChanged"/>
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10" Background="#AA292A2D">
        <StackPanel>
          <TextBlock x:Name="FileLabel" Text="尚未開啟 BVH 檔案" FontWeight="Bold"/>
          <TextBlock x:Name="InfoLabel" Margin="0,5,0,0" Foreground="#B8C1CC"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
